<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:ExamenPractico.Models"
               x:TypeArguments="models:Libro"
               x:Class="ExamenPractico.Views.LibroPopup"
               BackgroundColor="Transparent">

    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2B2B}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#555555}"
            StrokeThickness="1"
            Padding="0"
            WidthRequest="376"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <ScrollView MaximumHeightRequest="440">
            <VerticalStackLayout Padding="18" Spacing="10">

                <Label Text="Editar libro"
                       FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Grid ColumnDefinitions="95,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="6" ColumnSpacing="8">

                    <Label Grid.Row="0" Grid.Column="0" Text="Título *" FontSize="13"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
                    <Entry Grid.Row="0" Grid.Column="1" x:Name="EntryTitulo" Placeholder="Título *"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Autor/es" FontSize="13"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
                    <Entry Grid.Row="1" Grid.Column="1" x:Name="EntryAutores" Placeholder="Autores"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Año" FontSize="13"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
                    <Entry Grid.Row="2" Grid.Column="1" x:Name="EntryAnio" Placeholder="Año de edición"
                           Keyboard="Numeric"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="ISBN *" FontSize="13"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
                    <Entry Grid.Row="3" Grid.Column="1" x:Name="EntryISBN" Placeholder="ISBN *"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Portada" FontSize="13"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
                    <Entry Grid.Row="4" Grid.Column="1" x:Name="EntryUrlPortada" Placeholder="URL de la portada"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </Grid>

                <Label x:Name="LabelError" TextColor="Red" IsVisible="False"
                       FontSize="14" FontAttributes="Bold" />

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button x:Name="BtnGuardarCambios" Text="Guardar cambios" Clicked="BtnGuardarCambios_Clicked"/>
                    <Button x:Name="BtnCancelar" Text="Cancelar" Clicked="BtnCancelar_Clicked" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>