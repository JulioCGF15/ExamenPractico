<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExamenPractico.MainPage"
             Title="Catálogo de Libros">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registrar libro" FontSize="20" FontAttributes="Bold" />

            <!-- ===== Formulario de captura ===== -->
            <Entry x:Name="EntryTitulo" Placeholder="Título *" />
            <Entry x:Name="EntryAutores" Placeholder="Autores" />
            <Entry x:Name="EntryAnio" Placeholder="Año de edición" Keyboard="Numeric" />
            <Entry x:Name="EntryISBN" Placeholder="ISBN *" />
            <Entry x:Name="EntryUrlPortada" Placeholder="URL de la portada" />

            <Label x:Name="LabelError"
                   TextColor="Red"
                   IsVisible="False" />

            <Button x:Name="BtnGuardar"
                    Text="Guardar"
                    Clicked="BtnGuardar_Clicked" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <!-- ===== CollectionView base ===== -->
            <!-- ===== CollectionView ===== -->
       <Label Text="Libros registrados"
       FontSize="18"
       FontAttributes="Bold" />

            <CollectionView x:Name="CollectionViewLibros"
                SelectionMode="Single"
                SelectionChanged="CollectionViewLibros_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="5"
                Padding="10"
                Stroke="LightGray"
                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <HorizontalStackLayout Spacing="15">

                                <!-- Portada -->
                                <Image Source="{Binding UrlPortada}"
                       HeightRequest="120"
                       WidthRequest="80"
                       Aspect="AspectFit" />

                                <!-- Información -->
                                <VerticalStackLayout VerticalOptions="Center"
                                     Spacing="5">

                                    <Label Text="{Binding Titulo}"
                           FontAttributes="Bold"
                           FontSize="18" />

                                    <Label Text="{Binding Autores}"
                           FontSize="14" />

                                    <Label Text="{Binding AnioEdicion, StringFormat='Año: {0}'}"
                           FontSize="14" />

                                    <Label Text="{Binding ISBN, StringFormat='ISBN: {0}'}"
                           FontSize="14" />

                                </VerticalStackLayout>

                            </HorizontalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>