<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExamenPractico.MainPage"
             Title="Catálogo de Libros">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registrar libro" FontSize="20" FontAttributes="Bold" />

            <!-- ===== Formulario de captura ===== -->
            <Entry x:Name="EntryTitulo" Placeholder="Título *" />
            <Entry x:Name="EntryAutores" Placeholder="Autores" />
            <Entry x:Name="EntryAnio" Placeholder="Año de edición" Keyboard="Numeric" />
            <Entry x:Name="EntryISBN" Placeholder="ISBN *" />
            <Entry x:Name="EntryUrlPortada" Placeholder="URL de la portada" />

            <Label x:Name="LabelError"
                   TextColor="Red"
                   IsVisible="False" />

            <Button x:Name="BtnGuardar"
                    Text="Guardar"
                    Clicked="BtnGuardar_Clicked" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <!-- ===== CollectionView base ===== -->
            <!-- ===== CollectionView ===== -->
       <Label Text="Libros registrados"
       FontSize="18"
       FontAttributes="Bold" />

            <CollectionView x:Name="CollectionViewLibros"
                HeightRequest="320"
                SelectionMode="Single"
                SelectionChanged="CollectionViewLibros_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="5"
                Padding="10"
                Stroke="LightGray"
                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <HorizontalStackLayout Spacing="15">

                                <!-- Portada -->
                                <Image Source="{Binding UrlPortada}"
                       HeightRequest="120"
                       WidthRequest="80"
                       Aspect="AspectFit" />

                                <!-- Información -->
                                <VerticalStackLayout VerticalOptions="Center"
                                     Spacing="5">

                                    <Label Text="{Binding Titulo}"
                           FontAttributes="Bold"
                           FontSize="18" />

                                    <Label Text="{Binding Autores}"
                           FontSize="14" />

                                    <Label Text="{Binding AnioEdicion, StringFormat='Año: {0}'}"
                           FontSize="14" />

                                    <Label Text="{Binding ISBN, StringFormat='ISBN: {0}'}"
                           FontSize="14" />

                                </VerticalStackLayout>

                            </HorizontalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Border x:Name="PanelDetalle"
                    IsVisible="False"
                    Padding="12"
                    Stroke="#512BD4"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="15">
                    <Image x:Name="ImgDetallePortada"
                           HeightRequest="140"
                           WidthRequest="95"
                           Aspect="AspectFit" />
                    <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                        <Label Text="LIBRO SELECCIONADO" FontSize="12" TextColor="Gray" />
                        <Label x:Name="LblDetalleTitulo" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="LblDetalleAutores" FontSize="14" />
                        <Label x:Name="LblDetalleAnio" FontSize="14" />
                        <Label x:Name="LblDetalleIsbn" FontSize="14" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button x:Name="BtnEditar" Text="Editar" Clicked="BtnEditar_Clicked"/>
                <Button x:Name="BtnEliminar" Text="Eliminar" Clicked="BtnEliminar_Clicked"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>