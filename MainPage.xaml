<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExamenPractico.MainPage"
             Title="Catálogo de Libros">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registrar libro" FontSize="20" FontAttributes="Bold" />

            <!-- ===== Formulario de captura ===== -->
            <Entry x:Name="EntryTitulo" Placeholder="Título *" />
            <Entry x:Name="EntryAutores" Placeholder="Autores" />
            <Entry x:Name="EntryAnio" Placeholder="Año de edición" Keyboard="Numeric" />
            <Entry x:Name="EntryISBN" Placeholder="ISBN *" />
            <Entry x:Name="EntryUrlPortada" Placeholder="URL de la portada" />

            <Label x:Name="LabelError"
                   TextColor="Red"
                   IsVisible="False" />

            <Button x:Name="BtnGuardar"
                    Text="Guardar"
                    Clicked="BtnGuardar_Clicked" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <!-- ===== CollectionView base ===== -->
            <Label Text="Libros registrados" FontSize="18" FontAttributes="Bold" />

            <CollectionView x:Name="CollectionViewLibros"
                            SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="5">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                            <Label Text="{Binding Autores}" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>